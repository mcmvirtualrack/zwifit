{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zwifit.local/schemas/device-add.json",
  "description": "POST /api/devices: a client let in by its IP address, without pairing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "ip"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "ip": { "type": "string", "minLength": 2, "maxLength": 45 }
  }
}
