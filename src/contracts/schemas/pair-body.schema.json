{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zwifit.local/schemas/pair-body.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["code"],
  "properties": { "code": { "type": "string", "minLength": 8, "maxLength": 9, "pattern": "^[0-9A-Za-z]{4}-?[0-9A-Za-z]{4}$" }, "deviceName": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[^\u0000-\u001F\u007F]+$" } }
}
