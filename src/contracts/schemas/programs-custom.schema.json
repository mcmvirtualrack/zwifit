{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zwifit.local/schemas/programs-custom.json",
  "description": "A custom training program (programs:createCustom; programs:updateCustom with id): which of your plans to run on which weekday of which week.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "startDate", "weeks", "days"],
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\u0000-\u001F\u007F]+$" },
    "startDate": { "description": "Any day of week 1; the program starts on that week's Monday.", "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "weeks": { "type": "integer", "minimum": 1, "maximum": 52 },
    "days": {
      "type": "array",
      "maxItems": 364,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["week", "weekday", "planId"],
        "properties": {
          "week": { "type": "integer", "minimum": 1, "maximum": 52 },
          "weekday": { "description": "Monday = 0 … Sunday = 6.", "type": "integer", "minimum": 0, "maximum": 6 },
          "planId": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" }
        }
      }
    }
  }
}
