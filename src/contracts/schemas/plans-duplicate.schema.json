{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zwifit.local/schemas/plans-duplicate.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id"],
  "properties": { "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" }, "name": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\u0000-\u001F\u007F]+$" } }
}
