{
  "id": "/",
  "name": "Zwifit",
  "short_name": "Zwifit",
  "description": "Treadmill control, training plans and history.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#080b10",
  "theme_color": "#080b10",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Workout", "url": "/workout", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Plans", "url": "/plans", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "History", "url": "/history", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
